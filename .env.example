# ==============================================================================
# RPA-REVERT-PROXY — MASTER ENVIRONMENT SCHEMA (.env.example) — v1.1.0
# ==============================================================================
# QUY TẮC:
# 1. File này là Single Source of Truth cho toàn bộ biến môi trường của dự án.
# 2. KHÔNG điền mật khẩu/token thật vào file này (dùng mẫu CHANGE_ME_<TEN_BIEN>).
# 3. Sau khi thêm/đổi/xóa biến tại đây, chạy: python scripts/check_env_sync.py --sync
# ==============================================================================

# ------------------------------------------------------------------------------
# [1] CHẾ ĐỘ TRIỂN KHAI & ĐỊNH DANH NODE [ALL]
# ------------------------------------------------------------------------------
# [ALL] Chế độ chạy: local-all-in-one (1 Server có cả Hub + Satellite) | prod-hub | prod-satellite
DEPLOY_MODE=local-all-in-one

# [ALL] Mã định danh của máy chủ hiện tại (VD: node1, node2, hub1)
NODE_ID=node1

# [ALL] Múi giờ đồng bộ log giữa các container và Host
TZ=Asia/Ho_Chi_Minh

# ------------------------------------------------------------------------------
# [2] HẠ TẦNG OS, MẠNG HOST & DUMMY INTERFACE (FR-01) [ALL]
# ------------------------------------------------------------------------------
# [ALL] Tên card mạng LAN vật lý chính của máy chủ
HOST_LAN_INTERFACE=eth0

# [ALL] Địa chỉ IPv4 card mạng chính của máy chủ (HAProxy Inbound chỉ bind vào IP này)
HOST_LAN_IP=192.168.56.10

# [ALL] DNS Server thật cho HAProxy resolvers (không trỏ vào stub 127.0.0.53)
HOST_UPSTREAM_DNS_1=1.1.1.1
HOST_UPSTREAM_DNS_2=8.8.8.8

# [ALL] Interface ảo cố định ở tầng OS phục vụ host-gateway-ip & HAProxy Outbound
DUMMY_INTERFACE_NAME=dummy0
DUMMY_OUTBOUND_IP=10.254.254.1

# [HUB_OR_LOCAL] Subnet và Gateway cố định cho mạng Docker quản trị Hub (mgmt_internal)
MGMT_SUBNET=172.25.0.0/24
MGMT_GATEWAY_IP=172.25.0.1

# ------------------------------------------------------------------------------
# [3] CẤU HÌNH HAPROXY DATA PLANE & PROMETHEUS METRICS (FR-02, FR-03, FR-07) [ALL]
# ------------------------------------------------------------------------------
# [ALL] Image HAProxy bản LTS tối giản giảm bề mặt CVE
HAPROXY_IMAGE=haproxy:3.0-alpine

# [ALL] Thư mục cấu hình, chứng chỉ TLS (0600 root:root) & stats socket trên Host
HAPROXY_CONFIG_HOST_DIR=/etc/haproxy
HAPROXY_SSL_HOST_DIR=/etc/ssl/haproxy
HAPROXY_RUNTIME_SOCKET_DIR=/var/run/haproxy

# [ALL] Cổng loopback nội bộ xuất Prometheus metrics (/metrics) & trang /stats
HAPROXY_METRICS_PORT=8405

# [ALL] Thời gian tối đa graceful drain trước khi đóng cưỡng chế worker cũ sau reload
HAPROXY_HARD_STOP_AFTER=60s

# [ALL] Kích thước buffer header (bytes) đủ chứa cookie OIDC/JWT lớn của Authentik
HAPROXY_TUNE_BUFSIZE=32768

# [ALL] Phiên bản TLS tối thiểu cho chiều Inbound
HAPROXY_TLS_MIN_VER=TLSv1.2

# [ALL] Thời gian chờ đọc gói TLS ClientHello ở chiều Outbound SNI Passthrough
OUTBOUND_INSPECT_DELAY=5s

# [ALL] Timeout kết nối dài hạn cho luồng WebSocket Outpost (/ws/outpost/)
OUTBOUND_WSS_TIMEOUT=3600s

# [ALL] Danh sách domain đối tác bên ngoài cho phép gọi qua SNI Passthrough (phân cách dấu phẩy)
OUTBOUND_ALLOWED_DOMAINS=httpbin.org,api.github.com

# ------------------------------------------------------------------------------
# [4] XÁC THỰC SSO AUTHENTIK & STANDALONE PROXY OUTPOST (FR-05) [HUB_OR_LOCAL]
# ------------------------------------------------------------------------------
# [HUB_OR_LOCAL] Phiên bản Authentik (BẮT BUỘC ghim cứng khớp Server & Proxy, CẤM dùng latest)
AUTHENTIK_TAG=2026.8.3

# [HUB_OR_LOCAL] Tên miền và URL của Authentik Main (Local: auth.local.test | Prod: auth.main-domain.com)
AUTHENTIK_DOMAIN=auth.local.test
AUTHENTIK_HOST=https://auth.local.test

# [HUB_OR_LOCAL] IP đích của Authentik Main ở backend HAProxy Outbound (Local/Hub: trùng HOST_LAN_IP)
AUTHENTIK_MAIN_BACKEND_IP=192.168.56.10

# [HUB_OR_LOCAL] Token của Outpost trên Hub (được ánh xạ sang biến AUTHENTIK_TOKEN của container)
AUTHENTIK_OUTPOST_TOKEN=CHANGE_ME_AUTHENTIK_OUTPOST_TOKEN

# [HUB_OR_LOCAL] Cổng loopback trên Host nhận lưu lượng trình duyệt đẩy vào authentik-proxy
AUTHENTIK_PROXY_LOOPBACK_PORT=9000

# [HUB_OR_LOCAL] Tên Group trên Authentik được cấp quyền truy cập OpenManager Portal
AUTHENTIK_ALLOWED_GROUP=infra-admins

# [ALL] Bỏ qua kiểm tra SSL khi gọi nội bộ lab tự ký (Local lab: true | Prod: bắt buộc false)
AUTHENTIK_INSECURE=true

# ------------------------------------------------------------------------------
# [5] CENTRAL CONTROL PLANE — HAPROXY OPENMANAGER & PULL AGENT (FR-06) [ALL]
# ------------------------------------------------------------------------------
# [HUB_OR_LOCAL] Phiên bản ghim cứng của haproxy-openmanager (CẤM dùng latest)
OPENMANAGER_TAG=1.12.3

# [ALL] Tên miền Portal Quản trị Tập trung (Trình duyệt vào qua SSO; Satellite Agent gọi Pull API)
OPENMANAGER_PUBLIC_DOMAIN=portal.local.test

# [HUB_OR_LOCAL] Endpoint HTTP nội bộ của bộ định tuyến OpenManager (thay thế hoàn toàn Nginx)
OPENMANAGER_INTERNAL_URL=http://openmanager-router:8080

# [HUB_OR_LOCAL] Cổng loopback trên Hub dành riêng cho luồng API /api/agents* có X-API-Key
OPENMANAGER_AGENT_API_LOOPBACK_PORT=9002

# [SATELLITE_OR_LOCAL] Địa chỉ IP của Hub Server để haproxy-agent trên node vệ tinh kết nối HTTPS
OPENMANAGER_HUB_BACKEND_IP=192.168.56.10

# [HUB_OR_LOCAL] Cấu hình PostgreSQL & Redis nội bộ của HAProxy OpenManager
OPENMANAGER_POSTGRES_IMAGE=postgres:15-alpine
OPENMANAGER_POSTGRES_DB=haproxy_openmanager
OPENMANAGER_POSTGRES_USER=haproxy_user
OPENMANAGER_POSTGRES_PASSWORD=CHANGE_ME_OPENMANAGER_POSTGRES_PASSWORD
OPENMANAGER_REDIS_IMAGE=redis:7.4-alpine
OPENMANAGER_SECRET_KEY=CHANGE_ME_OPENMANAGER_SECRET_KEY

# [SATELLITE_OR_LOCAL] Chu kỳ đồng bộ (giây), Pool/Cluster ID và API Token của haproxy-agent
OPENMANAGER_POLL_INTERVAL=30
OPENMANAGER_POOL_ID=1
OPENMANAGER_CLUSTER_ID=1
OPENMANAGER_AGENT_TOKEN=CHANGE_ME_OPENMANAGER_AGENT_TOKEN

# [SATELLITE_OR_LOCAL] Khóa cứng chống tự cập nhật script từ xa (BẮT BUỘC false + chattr +i)
OPENMANAGER_ALLOW_AGENT_SELF_UPGRADE=false

# ------------------------------------------------------------------------------
# [6] ỨNG DỤNG NGHIỆP VỤ / MOCK SERVICE A KIỂM THỬ (FR-04) [SATELLITE_OR_LOCAL]
# ------------------------------------------------------------------------------
# [SATELLITE_OR_LOCAL] Tên miền Inbound và cổng loopback 127.0.0.1 của ứng dụng mẫu
APP_PUBLIC_DOMAIN=app.local.test
APP_LOOPBACK_PORT=8081
APP_CONTAINER_PORT=8080
APP_TEST_OUTBOUND_DOMAIN=httpbin.org

# ------------------------------------------------------------------------------
# [7] DATABASE & KHỞI TẠO AUTHENTIK MAIN (FR-05) [HUB_OR_LOCAL]
# ------------------------------------------------------------------------------
# [HUB_OR_LOCAL] Cổng loopback trên Host cho Authentik Main Server (tách biệt cổng 9000 của Proxy)
LOCAL_IDP_LOOPBACK_PORT=9001

# [HUB_OR_LOCAL] Cấu hình PostgreSQL & Secret Key cho Authentik Main (2026.x Redis-free)
LOCAL_IDP_POSTGRES_IMAGE=postgres:16-alpine
LOCAL_IDP_POSTGRES_DB=authentik
LOCAL_IDP_POSTGRES_USER=authentik
LOCAL_IDP_POSTGRES_PASSWORD=CHANGE_ME_LOCAL_IDP_POSTGRES_PASSWORD
LOCAL_IDP_SECRET_KEY=CHANGE_ME_LOCAL_IDP_SECRET_KEY_MIN_50_CHARS

# [LOCAL_ONLY] Tài khoản quản trị & API Token khởi tạo tự động cho môi trường Lab 1-Server
LOCAL_IDP_BOOTSTRAP_EMAIL=admin@local.test
LOCAL_IDP_BOOTSTRAP_PASSWORD=CHANGE_ME_LOCAL_IDP_BOOTSTRAP_PASSWORD
LOCAL_IDP_BOOTSTRAP_TOKEN=CHANGE_ME_LOCAL_IDP_BOOTSTRAP_TOKEN
