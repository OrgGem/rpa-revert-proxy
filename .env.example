# ==============================================================================
# RPA-PRORY — MASTER ENVIRONMENT SCHEMA (.env.example)
# ==============================================================================
# QUY TẮC:
# 1. File này là Single Source of Truth cho toàn bộ biến môi trường của dự án.
# 2. KHÔNG điền mật khẩu/token thật vào file này (dùng mẫu CHANGE_ME_<TEN_BIEN>).
# 3. Sau khi thêm/sửa biến tại đây, chạy: python scripts/check_env_sync.py --sync
# ==============================================================================

# ------------------------------------------------------------------------------
# [1] CHẾ ĐỘ TRIỂN KHAI & ĐỊNH DANH NODE [ALL]
# ------------------------------------------------------------------------------
# [ALL] Chế độ chạy: local-all-in-one (1 Server có cả IdP + Proxy) | prod-satellite | prod-hub
DEPLOY_MODE=local-all-in-one

# [ALL] Mã định danh của máy chủ hiện tại (VD: node1, node2, hub)
NODE_ID=node1

# [ALL] Múi giờ đồng bộ log giữa các container và Host
TZ=Asia/Ho_Chi_Minh

# ------------------------------------------------------------------------------
# [2] HẠ TẦNG OS, MẠNG HOST & DUMMY INTERFACE (FR-01) [ALL]
# ------------------------------------------------------------------------------
# [ALL] Tên card mạng LAN vật lý chính của máy chủ
HOST_LAN_INTERFACE=eth0

# [ALL] Địa chỉ IPv4 card mạng chính của máy chủ (HAProxy Inbound chỉ bind vào IP này)
HOST_LAN_IP=192.168.56.10

# [ALL] DNS Server thật cho HAProxy resolvers (không trỏ vào stub 127.0.0.53)
HOST_UPSTREAM_DNS_1=1.1.1.1
HOST_UPSTREAM_DNS_2=8.8.8.8

# [ALL] Interface ảo cố định ở tầng OS phục vụ host-gateway-ip & HAProxy Outbound
DUMMY_INTERFACE_NAME=dummy0
DUMMY_OUTBOUND_IP=10.254.254.1

# [ALL] Subnet và Gateway cố định cho mạng Docker quản trị cô lập (mgmt_internal)
MGMT_SUBNET=172.25.0.0/24
MGMT_GATEWAY_IP=172.25.0.1

# ------------------------------------------------------------------------------
# [3] CẤU HÌNH HAPROXY INBOUND & OUTBOUND (FR-02, FR-03, FR-07) [ALL]
# ------------------------------------------------------------------------------
# [ALL] Image HAProxy bản LTS tối giản giảm bề mặt CVE
HAPROXY_IMAGE=haproxy:3.0-alpine

# [ALL] Thư mục lưu trữ cấu hình HAProxy trên Host (bind mount vào container)
HAPROXY_CONFIG_HOST_DIR=/etc/haproxy

# [ALL] Thời gian tối đa giữ worker cũ sau khi reload USR2 (tránh treo zombie worker)
HAPROXY_HARD_STOP_AFTER=60s

# [ALL] Kích thước buffer header (bytes) đủ chứa cookie OIDC/JWT lớn của Authentik
HAPROXY_TUNE_BUFSIZE=32768

# [ALL] Phiên bản TLS tối thiểu cho chiều Inbound
HAPROXY_TLS_MIN_VER=TLSv1.2

# [ALL] Thời gian chờ đọc gói TLS ClientHello ở chiều Outbound SNI Passthrough
OUTBOUND_INSPECT_DELAY=5s

# [ALL] Timeout kết nối dài hạn cho luồng WebSocket Outpost (/ws/outpost/)
OUTBOUND_WSS_TIMEOUT=3600s

# [ALL] Danh sách domain đối tác bên ngoài cho phép gọi qua SNI Passthrough (phân cách dấu phẩy)
OUTBOUND_ALLOWED_DOMAINS=httpbin.org,api.github.com

# ------------------------------------------------------------------------------
# [4] XÁC THỰC SSO AUTHENTIK & STANDALONE PROXY OUTPOST (FR-05) [ALL]
# ------------------------------------------------------------------------------
# [ALL] Phiên bản Authentik (BẮT BUỘC ghim cứng khớp Server chính & Proxy, CẤM dùng latest)
AUTHENTIK_TAG=2026.8.3

# [ALL] Tên miền truy cập của Server Authentik Main (Local: auth.local.test | Prod: auth.main-domain.com)
AUTHENTIK_DOMAIN=auth.local.test

# [ALL] URL đầy đủ của Authentik Main để authentik-proxy kết nối HTTPS/WSS
AUTHENTIK_HOST=https://auth.local.test

# [ALL] IP đích của Authentik Main ở backend HAProxy Outbound (Local 1-Server: trùng HOST_LAN_IP)
AUTHENTIK_MAIN_BACKEND_IP=192.168.56.10

# [ALL] Token định danh riêng cho Outpost của node này (trích xuất từ Authentik Main)
AUTHENTIK_OUTPOST_TOKEN=CHANGE_ME_AUTHENTIK_OUTPOST_TOKEN

# [ALL] Cổng loopback trên Host nhận lưu lượng từ HAProxy Inbound đẩy vào authentik-proxy
AUTHENTIK_PROXY_LOOPBACK_PORT=9000

# [ALL] Tên Group trên Authentik được cấp quyền truy cập Roxy-WI
AUTHENTIK_ALLOWED_GROUP=infra-admins

# [ALL] Bỏ qua kiểm tra SSL khi gọi tới Authentik Main (Local lab tự ký: true | Prod: bắt buộc false)
AUTHENTIK_INSECURE=true

# ------------------------------------------------------------------------------
# [5] PORTAL QUẢN TRỊ ROXY-WI & SSH ĐẶC QUYỀN TỐI THIỂU (FR-06) [ALL]
# ------------------------------------------------------------------------------
# [ALL] Image Roxy-WI đã vá lỗ hổng bảo mật (>= 8.2.8.2 hoặc nhánh container chính thức 9.1.x+)
ROXYWI_IMAGE=ghcr.io/roxy-wi/roxy-wi:9.1.0

# [ALL] Tên miền truy cập Roxy-WI của node vệ tinh qua lớp bảo vệ Authentik Proxy
ROXYWI_PUBLIC_DOMAIN=roxy-node1.local.test

# [ALL] Endpoint nội bộ của Roxy-WI trong mạng mgmt_internal (HTTPS port 443 tự ký)
ROXYWI_INTERNAL_URL=https://roxy-wi:443

# [ALL] User hệ thống riêng trên Host cho Roxy-WI SSH cục bộ (KHÔNG thuộc group docker)
ROXYWI_SSH_USER=roxyadmin

# [ALL] Cổng SSH cục bộ trên Host nhận kết nối từ dải mạng MGMT_SUBNET
ROXYWI_SSH_PORT=22

# [ALL] UID/GID của tiến trình haproxy trong container để đồng bộ ACL trên /etc/haproxy
ROXYWI_HAPROXY_UID=99
ROXYWI_HAPROXY_GID=99

# ------------------------------------------------------------------------------
# [6] ỨNG DỤNG NGHIỆP VỤ / MOCK SERVICE A KIỂM THỬ (FR-04) [ALL]
# ------------------------------------------------------------------------------
# [ALL] Tên miền Inbound cho ứng dụng mẫu / ứng dụng nghiệp vụ
APP_PUBLIC_DOMAIN=app.local.test

# [ALL] Cổng expose trên loopback 127.0.0.1 của Host cho ứng dụng
APP_LOOPBACK_PORT=8081

# [ALL] Cổng lắng nghe bên trong container ứng dụng
APP_CONTAINER_PORT=8080

# [ALL] Tên miền đối tác mẫu dùng để kiểm thử tự động chiều Outbound từ trong container
APP_TEST_OUTBOUND_DOMAIN=httpbin.org

# ------------------------------------------------------------------------------
# [7] STACK AUTHENTIK MAIN GIẢ LẬP CHO MÔI TRƯỜNG 1 SERVER [LOCAL_ONLY]
# ------------------------------------------------------------------------------
# [LOCAL_ONLY] Cổng loopback trên Host cho Authentik Main Server (tránh đụng cổng 9000 của Proxy)
LOCAL_IDP_LOOPBACK_PORT=9001

# [LOCAL_ONLY] Cấu hình PostgreSQL nội bộ cho Authentik Main khi test 1-Server
LOCAL_IDP_POSTGRES_IMAGE=postgres:16-alpine
LOCAL_IDP_POSTGRES_DB=authentik
LOCAL_IDP_POSTGRES_USER=authentik
LOCAL_IDP_POSTGRES_PASSWORD=CHANGE_ME_LOCAL_IDP_POSTGRES_PASSWORD

# [LOCAL_ONLY] Khóa bí mật ký session/JWT của Authentik Main (tối thiểu 50 ký tự khi chạy thật)
LOCAL_IDP_SECRET_KEY=CHANGE_ME_LOCAL_IDP_SECRET_KEY_MIN_50_CHARS

# [LOCAL_ONLY] Tài khoản quản trị khởi tạo tự động lần đầu cho môi trường Local Lab
LOCAL_IDP_BOOTSTRAP_EMAIL=admin@local.test
LOCAL_IDP_BOOTSTRAP_PASSWORD=CHANGE_ME_LOCAL_IDP_BOOTSTRAP_PASSWORD
LOCAL_IDP_BOOTSTRAP_TOKEN=CHANGE_ME_LOCAL_IDP_BOOTSTRAP_TOKEN
